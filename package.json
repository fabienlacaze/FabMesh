{
  "name": "myfabmesh-ai",
  "version": "1.0.0",
  "description": "MyFabmesh.AI — image-to-3D mesh generator with local AI.",
  "main": "src/main/main.js",
  "author": {
    "name": "Fabien Lacaze",
    "email": "fabien65400@hotmail.fr"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE= && electron .",
    "dev": "set ELECTRON_RUN_AS_NODE= && electron . --dev",
    "launch": "start.bat",
    "build:installer": "electron-builder --win nsis",
    "build:installer:dir": "electron-builder --win nsis --dir"
  },
  "dependencies": {
    "@google/model-viewer": "^4.2.0",
    "@sentry/electron": "^7.13.0",
    "electron-updater": "^6.8.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.myfabmesh.desktop",
    "productName": "MyFabmesh.AI",
    "copyright": "Copyright © 2026 Fabien Lacaze",
    "directories": {
      "output": "dist/installer",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "scripts/**/*.py",
      "scripts/**/*.png",
      "icon.png",
      "icon.ico",
      "!**/__pycache__",
      "!**/.venv",
      "!**/*.pyc",
      "!**/*.log",
      "!**/_dbg_*.*",
      "!**/test_*.py"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "build/python-embed",
        "to": "python-embed",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      },
      {
        "from": "build/hf_fallback_token.txt",
        "to": "hf_fallback_token.txt"
      },
      {
        "from": "build/sentry-dsn.txt",
        "to": "sentry-dsn.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Fabien Lacaze",
      "verifyUpdateCodeSignature": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fabienlacaze",
        "repo": "MyFabmesh",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyFabmesh.AI",
      "uninstallDisplayName": "MyFabmesh.AI ${version}",
      "deleteAppDataOnUninstall": false,
      "include": "build/uninstaller.nsh",
      "license": "LICENSE.txt",
      "artifactName": "MyFabmesh.AI-Setup-${version}.${ext}",
      "differentialPackage": true
    }
  }
}

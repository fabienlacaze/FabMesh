{
  "name": "myfabmesh-ai",
  "version": "1.0.10",
  "description": "MyFabmesh.AI — image-to-3D mesh generator with local AI.",
  "main": "src/main/main.js",
  "author": {
    "name": "Ayros Studio",
    "email": "fabien65400@hotmail.fr"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "_releaseGuards": {
    "note": "Metadata only — ignored by npm and electron-builder. Documents packaging constraints that must not be violated.",
    "doNotBundleMotionLibrary": "NE PAS ajouter external/apovivor (ni aucun pack de motions FBX Mixamo/Rokoko/apovivor) à build.files ni à build.extraResources tant que la provenance de CHAQUE clip FBX n'est pas tracée et ses droits de redistribution vérifiés. Ces licences interdisent la redistribution des motions brutes. Voir THIRD_PARTY_LICENSES.txt (clause 'motion library') et src/main/animation.js (chargement DEV-ONLY hors-arbre).",
    "puppeteerExcludesAnimation": "Le bloc extraResources de external/Puppeteer exclut volontairement animation/ examples/ inputs/ assets/ et les checkpoints. Ne pas retirer ces exclusions."
  },
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE= && electron .",
    "dev": "set ELECTRON_RUN_AS_NODE= && electron . --dev",
    "launch": "start.bat",
    "build:installer": "electron-builder --win nsis && node build/organize_dist.js",
    "build:installer:dir": "electron-builder --win nsis --dir",
    "build:msix": "electron-builder --win appx && node build/organize_dist.js",
    "build:all": "electron-builder --win nsis appx && node build/organize_dist.js"
  },
  "dependencies": {
    "@google/model-viewer": "^4.2.0",
    "@sentry/electron": "^7.13.0",
    "electron-updater": "^6.8.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "ai.myfabmesh.desktop",
    "productName": "MyFabmesh.AI",
    "copyright": "Copyright © 2026 Ayros Studio",
    "directories": {
      "output": "dist/installer",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "scripts/**/*.py",
      "scripts/**/*.png",
      "icon.png",
      "icon.ico",
      "!**/__pycache__",
      "!**/.venv",
      "!**/*.pyc",
      "!**/*.log",
      "!**/_dbg_*.*",
      "!**/test_*.py",
      "!**/*.backup",
      "!**/*.bak"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.py",
          "**/*.json",
          "**/*.npy",
          "**/*.png",
          "!**/.venv/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "external/TRELLIS2_win/src/trellis2",
        "to": "TRELLIS2_win/src/trellis2",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "external/Puppeteer",
        "to": "Puppeteer",
        "filter": [
          "**/*",
          "!venv/**",
          "!animation/**",
          "!examples/**",
          "!inputs/**",
          "!assets/**",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/.cache/**",
          "!skeleton/skeleton_ckpts/**",
          "!skinning/skinning_ckpts/**",
          "!**/third_partys/Michelangelo/checkpoints/**",
          "!**/third_partys/PartField/assets/**",
          "!**/third_partys/PartField/applications/**",
          "!skeleton/data_utils/examples/**",
          "!demo_animation.sh",
          "!demo_rigging.sh"
        ]
      },
      {
        "from": "build/wheels",
        "to": "wheels",
        "filter": [
          "*.whl"
        ]
      },
      {
        "from": "build/python-embed",
        "to": "python-embed",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      },
      {
        "from": "build/sentry-dsn.txt",
        "to": "sentry-dsn.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "Ayros Studio"
      }
    },
    "appx": {
      "identityName": "AyrosStudio.MyFabmesh.AI",
      "publisher": "CN=3767FC33-F877-4481-9639-BC9CFF9D1371",
      "publisherDisplayName": "Ayros Studio",
      "applicationId": "MyFabmeshAI",
      "displayName": "MyFabmesh.AI",
      "languages": [
        "en-US",
        "fr-FR"
      ],
      "showNameOnTiles": true,
      "addAutoLaunchExtension": false,
      "backgroundColor": "#0b0b14"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fabienlacaze",
        "repo": "MyFabmesh",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyFabmesh.AI",
      "uninstallDisplayName": "MyFabmesh.AI ${version}",
      "deleteAppDataOnUninstall": false,
      "include": "build/uninstaller.nsh",
      "installerHeaderIcon": "icon.ico",
      "artifactName": "MyFabmesh.AI-Setup-${version}.${ext}",
      "differentialPackage": true
    }
  }
}

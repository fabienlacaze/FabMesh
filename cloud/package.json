{
  "name": "myfabmesh-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "MyFabmesh.AI Cloud frontend — Next.js static export + Cloudflare Worker",
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build && node scripts/stamp-assets.mjs",
    "start": "next start -p 3030",
    "lint": "next lint",
    "deploy": "wrangler deploy",
    "setup:supabase": "node scripts/supabase-setup.mjs",
    "setup:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-prod.ps1",
    "sync-app": "node scripts/sync-app.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "replicate": "^1.0.1",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "typescript": "^5.6",
    "wrangler": "^4.94.0"
  }
}

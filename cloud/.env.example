# Copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real keys.

# Replicate (server-side only)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Slug of our pushed Cog (initially can fall back to fishwowater/trellis2 for testing)
REPLICATE_MODEL=fabienlacaze/myfabmesh-cloud
# Pinned version hash (optional). Empty = always use latest.
REPLICATE_VERSION=

# Supabase (auth + DB)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxx

# Stripe (test mode keys for dev)
STRIPE_SECRET_KEY=sk_test_xxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxx

# Cloudflare R2 (mesh storage)
R2_ACCOUNT_ID=xxxxxxx
R2_ACCESS_KEY_ID=xxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxx
R2_BUCKET=myfabmesh-meshes
R2_PUBLIC_URL=https://pub-xxxxxxx.r2.dev

# HMAC secret for signed, expiring /r2/<key>?exp&sig URLs (P1 remediation).
# DO NOT put the real value here or in wrangler.toml — it is a Cloudflare
# Worker SECRET. Generate 32 random bytes and set it with:
#   openssl rand -hex 32 | npx wrangler secret put R2_URL_SIGNING_SECRET
# While UNSET, the worker falls back to public R2_PUBLIC_URL (non-breaking).
# After it is set + verified, disable the r2.dev public bucket in the
# Cloudflare dashboard so face photos are no longer publicly reachable.
# R2_URL_SIGNING_SECRET=<set via wrangler secret put, never committed>

# Site config
NEXT_PUBLIC_SITE_URL=http://localhost:3030

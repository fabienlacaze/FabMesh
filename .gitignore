# TRELLIS-2 native Windows install (third-party source + venv).
# `src/` is itself a nested git repo (third-party clone) — not tracked.
# Our Kaolin shim is in scripts/trellis2_kaolin_shim.py and is installed
# into the TRELLIS-2 tree by scripts/install_kaolin_shim.py.
external/TRELLIS/
external/TRELLIS2_win/.venv/
external/TRELLIS2_win/src/
external/TRELLIS2_win/_dbg_*.npy
external/TRELLIS2_win/test_*.py
# Vendored externals (clone-on-first-run pattern, not committed).
# All these are local checkouts; the install script clones them.
external/MV-Adapter/
external/Hi3DGen/
external/StableFast3D/
external/UniRig/

# Isolated venv for MV-Adapter (diffusers 0.30 + torch cu128, ~5 GB)
.venv-mvadapter/

# Isolated venv for SyncMVD (PyTorch3D, planned)
.venv-syncmvd/

# Secrets / tokens
.test_api_token
.mcp_bridge_token


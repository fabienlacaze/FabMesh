# TypeScript incremental build cache (regenerated by tsc on every check)
cloud/tsconfig.tsbuildinfo

# Local runtime logs (kept as artefacts on disk for debugging only)
logs/*.err

# Puppeteer rigging — Seed3D/Puppeteer cloned at ~22 GB (venv + checkpoints).
external/Puppeteer/

# Local-only security/legal audit reports (must NOT be published to the public repo)
audit/

# TRELLIS-2 custom wheels (fetched by build/fetch_trellis2_wheels.py from
# the trellis2-wheels-v1 GitHub prerelease, or copied from local builds)
build/wheels/
